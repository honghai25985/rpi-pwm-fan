## @file rpi-pwm-fan.env
## @brief Default GPIO, fan curve, timing, and electrical configuration.

# BCM numbering: GPIO14 is physical header pin 8 and also the UART TX pin.
RPI_PWM_FAN_GPIO=14

# The 52Pi ZP-0141 example drives its bundled fan at 100 Hz.
RPI_PWM_FAN_FREQUENCY=100

# Ordered temperature_C:speed_percent steps. Temperatures must increase, speeds
# must not decrease, and the final pair must reach either 85 C or 100% speed.
# At and above the 85 C safety ceiling the daemon always commands 100% speed.
RPI_PWM_FAN_CURVE=40:0,50:30,60:60,70:80,85:100

# Seconds between CPU temperature readings and downward-step hysteresis in C.
RPI_PWM_FAN_INTERVAL=5
RPI_PWM_FAN_HYSTERESIS=2

# Set true when the transistor/interface circuit inverts the PWM signal.
RPI_PWM_FAN_ACTIVE_LOW=false
